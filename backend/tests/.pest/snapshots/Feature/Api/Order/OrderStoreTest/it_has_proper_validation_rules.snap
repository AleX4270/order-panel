{
    "id": [
        "sometimes",
        "integer"
    ],
    "countryId": [
        "required",
        "integer"
    ],
    "provinceId": [
        "required",
        "integer"
    ],
    "cityId": [
        "required",
        "integer"
    ],
    "cityName": [
        "sometimes",
        "string"
    ],
    "postalCode": [
        "nullable",
        "string",
        "max:32"
    ],
    "address": [
        "required",
        "string",
        "max:255"
    ],
    "phoneNumber": [
        "required",
        "string"
    ],
    "priorityId": [
        "required",
        "integer"
    ],
    "statusId": [
        "required",
        "integer"
    ],
    "dateCreation": [
        "required",
        "date"
    ],
    "dateDeadline": [
        "required",
        "date",
        "after_or_equal:dateCreation"
    ],
    "dateCompleted": [
        "sometimes",
        "date",
        "after_or_equal:dateCreation"
    ],
    "remarks": [
        "sometimes",
        "string",
        "max:2000"
    ]
}